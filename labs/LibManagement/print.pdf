public class Book extends LibraryItem {
    private int availableCopies;

    public Book(int id, String title, int availableCopies) {
		super(id, title);
        this.availableCopies = availableCopies;
    }


	public int getAvailableCopies() {
		return availableCopies;
	}

	public void borrowBook() {
		if (availableCopies > 0) {
			availableCopies--;
			System.out.println("Book borrowed successfully.");
		} else {
			System.out.println("No available copies.");
		}
	}

	public void returnBook() {
		availableCopies++;
		System.out.println("Book returned successfully.");
	}

	@Override
	public void displayInfo() {
		System.out.println(
				"Book - ID: " + getId() +
				", Title: " + getTitle() +
				", Available Copies: " + availableCopies
				);
	}
}
public class Magazine extends LibraryItem {
    private int issueNumber;

    public Magazine(int id, String title, int issueNumber) {
        super(id, title);
        this.issueNumber = issueNumber;
    }

    @Override
    public void displayInfo() {
        System.out.println(
            "Magazine - ID: " + getId() +
            ", Title: " + getTitle() +
            ", Issue: " + issueNumber
        );
	}
}
public class LibraryItem {
    private int id;
    private String title;

    public LibraryItem(int id, String title) {
        this.id = id;
        this.title = title;
    }

    public int getId() {
        return id;
    }

    public String getTitle() {
        return title;
    }

    public void displayInfo() {
        System.out.println("ID: " + id + ", Title: " + title);
    }
}

import java.util.ArrayList;

public class LibraryApp {

    public static void main(String[] args) {
		ArrayList<Book> books = new ArrayList<>();

        books.add(new Book(101, "Java Programming", 3));
        books.add(new Book(102, "Database Fundamentals", 2));
        books.add(new Book(103, "Computer Networks", 4));

		books.add(new Book(357, "Physics", 5));

		System.out.println("===== Library Books =====");

        for (Book book : books) {
            book.displayInfo();
        }

        System.out.println("\nBorrowing Java Programming...");
        books.get(0).borrowBook();

        System.out.println("\nAfter Borrowing:");
        books.get(0).displayInfo();

        System.out.println("\nReturning Java Programming...");
        books.get(0).returnBook();

        System.out.println("\nAfter Returning:");
        books.get(0).displayInfo();

		System.out.println("Total books: " + books.size());

		String requiredTitle = "Physics";
		boolean found = false;

		for (Book book : books) {
			if (book.getTitle().equals(requiredTitle)) {
				found = true;
				break;
			}
		}

		if (found) {
			System.out.println("Title is available.");
		} else {
			System.out.println("Title is not available.");
		}

		for (Book book : books) {
			if (book.getTitle().equals("Physics")) {
				System.out.println( "Available copies: " + book.getAvailableCopies());
			}
		}

		for (Book book : books) {
			if (book.getTitle().equals("Physics")) {
				while (book.getAvailableCopies() > 0)
					book.borrowBook();
			}
		}

		for (Book book : books) {
			if (book.getTitle().equals("Physics")) {
				book.returnBook();
				break;
			}
		}

		Book result = findBookById(books, 357);

		if (result != null) {
			result.displayInfo();
		} else {
			System.out.println("Book not found.");
		}

		result = findBookById(books, 999);

		if (result != null) {
			result.displayInfo();
		} else {
			System.out.println("Book not found.");
		}
	}

	public static Book findBookById(ArrayList<Book> books, int id) {

		for (Book book : books) {
			if (book.getId() == id) {
				return book;
			}
		}
		return null;
	}

}
import java.util.ArrayList;

/* With the inclusion of Book under library item, a new main was made
 for consistency using its own updated class scheme.*/
public class LibraryApp2 {

	public static void main(String[] args) {
		ArrayList<LibraryItem> items = new ArrayList<>();

		items.add(new Book(357, "Physics", 5));
		items.add(new Book(102, "Database Fundamentals", 2));
		items.add(new Magazine(501, "Science Today", 12));

		for (LibraryItem item : items) {
			item.displayInfo();
		}

		System.out.println("\n===== FINAL LIBRARY REPORT =====");

		for (LibraryItem item : items) {
			item.displayInfo();
		}

		System.out.println("Total library items: " + items.size());
	}

	public static Book findBookById(ArrayList<Book> books, int id) {

		for (Book book : books) {
			if (book.getId() == id) {
				return book;
			}
		}
		return null;
	}

}
